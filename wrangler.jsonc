/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "journal",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-09",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
	/**
	 * D1 Database — 分野・年代ごとの論文・引用エッジ（SPEC.md 4.4, ARCHITECT.md 3.4）。
	 * 命名規則: binding は DB_FIELD{分野ID}_{開始年}_{終了年}。新しい分野・年代レンジを追加する際は、
	 * ここに binding を追加した上で worker/db.ts の DB_REGISTRY にも 1 行追加する（2026-11-10）。
	 * https://developers.cloudflare.com/d1/
	 * remote: true により、ローカル開発（vite dev）でも本番 D1 を直接参照する（ローカル D1 は P1 のテスト後に空のまま）。
	 * https://developers.cloudflare.com/workers/vite-plugin/reference/remote-bindings/
	 */
	"d1_databases": [
		{
			"binding": "DB_FIELD17_2016_2026",
			"database_name": "field17_2016_2026",
			"database_id": "256986fe-4e3a-45c4-801d-bd613dab19e6",
			"remote": true
		},
		// 5 年単位の年代 DB（SPEC.md 4.3、ARCHITECT.md 3.4.2、2026-11-11 作成）。
		// S3 スナップショットからの初期インポート（docs/init-ingest.md、scripts/ingest/）の投入先。
		// 動作確認後、上の field17_2016_2026（旧方針の仮 DB）を廃止する予定。
		{
			"binding": "DB_FIELD17_2006_2010",
			"database_name": "field17_2006_2010",
			"database_id": "674c579d-23d3-43c3-985e-61ec1d6bf7b5",
			"remote": true
		},
		{
			"binding": "DB_FIELD17_2011_2015",
			"database_name": "field17_2011_2015",
			"database_id": "964d0981-ad71-41ad-bb02-88c81993fc3e",
			"remote": true
		},
		{
			"binding": "DB_FIELD17_2016_2020",
			"database_name": "field17_2016_2020",
			"database_id": "fc881b17-24af-4eee-90e7-ec6d91f59eba",
			"remote": true
		},
		{
			"binding": "DB_FIELD17_2021_2025",
			"database_name": "field17_2021_2025",
			"database_id": "2dcce76f-dc22-49bc-9731-d65fc6826b02",
			"remote": true
		},
		{
			"binding": "DB_FIELD17_2026_2030",
			"database_name": "field17_2026_2030",
			"database_id": "c1e37da2-dd71-4ae6-b9e7-b722d29ba58d",
			"remote": true
		}
	],
	/**
	 * R2 Bucket — 生データ・シード単位グラフ JSON（ARCHITECT.md 3.5）
	 * https://developers.cloudflare.com/r2/
	 */
	"r2_buckets": [
		{
			"binding": "BUCKET_FIELD17",
			"bucket_name": "journal-field17"
		}
	],
	/**
	 * Queues — グラフ構築の非同期化（ARCHITECT.md 3.2）
	 * https://developers.cloudflare.com/queues/
	 */
	"queues": {
		"producers": [
			{
				"binding": "GRAPH_BUILD_QUEUE",
				"queue": "journal-graph-build"
			}
		],
		"consumers": [
			{
				"queue": "journal-graph-build"
			}
		]
	},
	/**
	 * Workflows — OpenAlex からの取り込み ETL（ARCHITECT.md 3.1）。
	 * https://developers.cloudflare.com/workflows/
	 */
	"workflows": [
		{
			"binding": "INGEST_WORKFLOW",
			"name": "journal-ingest-workflow",
			"class_name": "IngestWorkflow"
		}
	],
	/**
	 * Durable Objects — 外部 API 呼び出しのレート制御直列化（ARCHITECT.md 3.3）。
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER_OPENALEX",
				"class_name": "RateLimiterOpenAlex"
			},
			{
				"name": "RATE_LIMITER_SEMANTIC_SCHOLAR",
				"class_name": "RateLimiterSemanticScholar"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RateLimiterOpenAlex", "RateLimiterSemanticScholar"]
		}
	],
	/**
	 * Cron Trigger — 日次 1 回、Ingest Workflow を起動する（ARCHITECT.md 3.1）。
	 * UTC 18:00（JST 翌 3:00、深夜帯）。
	 * https://developers.cloudflare.com/workers/platform/cron-triggers
	 */
	"triggers": {
		"crons": ["0 18 * * *"]
	}
}